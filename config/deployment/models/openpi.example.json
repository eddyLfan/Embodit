{
  "version": 1,
  "kind": "model",
  "config_id": "openpi-checkpoint",
  "name": "OpenPI Checkpoint",
  "host": {
    "address": "192.0.2.10",
    "port": 22,
    "user": "model",
    "auth": {
      "type": "password_env",
      "environment_variable": "MODEL_SSH_PASSWORD"
    },
    "host_key_policy": "accept-new",
    "service_manager": "user"
  },
  "model": {
    "workdir": "/path/to/Embodit",
    "environment": {},
    "provider": "openpi",
    "checkpoint": "/path/to/checkpoints/pi0-task/10000",
    "python_executable": "/path/to/openpi-env/bin/python",
    "load_kwargs": {},
    "predict_kwargs": {},
    "startup_timeout_s": 300,
    "restart": "on-failure"
  },
  "endpoint": {"bind": "127.0.0.1", "port": 8000}
}
