{
  "version": 1,
  "kind": "model",
  "config_id": "my-vla",
  "name": "My VLA",
  "host": {
    "connection": "local",
    "address": "127.0.0.1",
    "port": 22,
    "user": "embodit",
    "service_manager": "user"
  },
  "model": {
    "workdir": "/path/to/model/project",
    "environment": {},
    "provider": "python",
    "entrypoint": "my_vla:MyVLA",
    "checkpoint": "/path/to/checkpoints/my-vla",
    "python_executable": "/path/to/model-env/bin/python",
    "load_kwargs": {},
    "predict_kwargs": {},
    "startup_timeout_s": 180,
    "restart": "on-failure"
  },
  "endpoint": {
    "bind": "127.0.0.1",
    "port": 8000
  }
}
