{
  "version": 1,
  "kind": "model",
  "config_id": "my-vla",
  "name": "My VLA",
  "host": {
    "connection": "local",
    "address": "192.168.10.10",
    "port": 22,
    "user": "root",
    "service_manager": "system"
  },
  "model": {
    "workdir": "/root/vla",
    "environment": {
      "CUDA_VISIBLE_DEVICES": "0"
    },
    "provider": "python",
    "entrypoint": "my_vla:MyVLA",
    "checkpoint": "/root/checkpoints/my-vla",
    "python_executable": "/root/miniconda3/envs/vla/bin/python",
    "load_kwargs": {},
    "predict_kwargs": {},
    "startup_timeout_s": 180,
    "restart": "on-failure"
  },
  "endpoint": {
    "bind": "127.0.0.1",
    "port": 8000
  }
}
