# Embodit does not load .env files automatically. Copy only the settings you
# need into a private .env, review them, then source it from the repository root:
# set -a; source .env; set +a
# Never commit the private .env or a real bearer token/credential.

EMBODY_ROOT=/path/to/datasets
EMBODY_HOST=127.0.0.1
EMBODY_PORT=8765
EMBODY_PUBLIC_HOST=localhost

# Leave unset to generate and persist a token under EMBODIT_STATE_DIR.
# EMBODY_TOKEN=

# Non-loopback launches enable this automatically unless explicitly configured.
EMBODIT_SANDBOX=1

# Optional runtime state and cache overrides. Prefer absolute paths; unset uses
# the repository-local .embodit and .embodit_cache defaults.
# EMBODIT_STATE_DIR=/path/to/private/embodit-state
# EMBODIT_CACHE_DIR=/path/to/private/embodit-cache

# Optional package setup and data-format fallbacks.
# EMBODIT_PYPI_MIRROR=official
# EMBODY_PROXY=http://proxy.example:8080
# EMBODIT_HDF5_FPS=30
# EMBODIT_MCAP_GAP_S=2.0
# EMBODIT_REVIEW_CONFIG=/path/to/review.json

# Optional cache/report retention. Zero TTL/count means matching unprotected
# items are immediately eligible; interval 0 disables periodic, not startup, cleanup.
# EMBODIT_PREVIEW_TTL_DAYS=7
# EMBODIT_MEDIA_TTL_DAYS=7
# EMBODIT_SAM_CACHE_TTL_DAYS=30
# EMBODIT_JOB_TTL_DAYS=30
# EMBODIT_TEMP_TTL_DAYS=1
# EMBODIT_QC_REPORTS_PER_DATASET=5
# EMBODIT_MAINTENANCE_INTERVAL_HOURS=24
